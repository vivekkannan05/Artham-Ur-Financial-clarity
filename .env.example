# ─────────────────────────────────────────────────────────────
# Artha — Environment Configuration
# Copy this to .env and fill in real values before running.
# This file (.env.example) is committed to git.
# The actual .env file is gitignored — never commit it.
# ─────────────────────────────────────────────────────────────

# === PostgreSQL ===
POSTGRES_DB=hfos
POSTGRES_USER=hfos
POSTGRES_PASSWORD=hfos_local

# === Backend (Spring Boot) ===
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/hfos
SPRING_DATASOURCE_USERNAME=hfos
SPRING_DATASOURCE_PASSWORD=hfos_local

# === PAN Encryption (AES-256) ===
# Generate a 32-character key. Example: openssl rand -base64 32
PAN_ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_REAL_KEY

# === Ollama (AI) ===
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# === CORS ===
CORS_ALLOWED_ORIGINS=http://localhost:3000

# === Logging ===
LOG_LEVEL=INFO
